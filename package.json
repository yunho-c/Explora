{
  "name": "explora",
  "version": "0.1.0",
  "private": true,
  "description": "A calm, modern file explorer for local and SSH locations.",
  "type": "module",
  "scripts": {
    "dev": "bun run tauri dev",
    "dev:web": "vite",
    "build": "bun run tauri build",
    "build:web": "vite build",
    "preview": "vite preview",
    "format": "bun run format:web && bun run format:rust",
    "format:web": "prettier --write .",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "bun run format:web:check && bun run format:rust:check",
    "format:web:check": "prettier --check .",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "lint": "bun run lint:web && bun run lint:rust",
    "lint:web": "eslint .",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check": "bun run check:web && bun run check:rust",
    "check:web": "svelte-check --tsconfig ./tsconfig.json",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test": "bun run test:web && bun run test:rust",
    "test:web": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.25.0",
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.1.1",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "eslint": "^10.7.0",
    "eslint-plugin-svelte": "^3.21.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "mode-watcher": "^1.1.0",
    "paneforge": "^1.0.2",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn-svelte": "^1.4.2",
    "svelte": "^5.53.0",
    "svelte-check": "^4.3.6",
    "svelte-sonner": "^1.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  }
}
