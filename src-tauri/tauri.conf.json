{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Explora",
  "version": "0.1.0",
  "identifier": "com.yunho-c.explora",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "devUrl": "http://localhost:6748",
    "beforeBuildCommand": "bun run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Explora",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
